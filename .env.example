# ==============================================================================
# J.A.R.V.I.S. Assistant - Archivo de Configuración de Entorno (.env)
# ==============================================================================

# 1. ELECCIÓN DEL PROVEEDOR LLM (gemini | ollama | lmstudio | openai)
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# OPCIÓN A: Si usas Google Gemini (Recomendado para máxima velocidad y visión)
# Obtén tu API Key gratis en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# OPCIÓN B: Si usas Ollama Local (100% privado y offline)
# Ejecuta antes: ollama run llama3.2-vision (o llava / qwen2.5-coder)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2-vision
# LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# OPCIÓN C: Si usas LM Studio Local
# Inicia el Local Server en LM Studio en el puerto 1234
# ------------------------------------------------------------------------------
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# LLM_API_KEY=lm-studio

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE VOZ (STT y TTS)
# ------------------------------------------------------------------------------
STT_ENABLED=true
STT_MODEL_SIZE=base           # tiny, base, small (para Whisper local)
STT_LANGUAGE=es

TTS_ENABLED=true
TTS_VOICE=es-MX-DaliaNeural    # es-MX-DaliaNeural, es-MX-JorgeNeural, es-ES-AlvaroNeural
TTS_RATE=+0%

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DE CÁMARA WEB
# ------------------------------------------------------------------------------
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# ------------------------------------------------------------------------------
# 4. HERRAMIENTAS DEL SISTEMA (TOOL CALLING)
# ------------------------------------------------------------------------------
ENABLE_TOOLS=true
